COMPOSE_PROJECT_NAME=shadowalker
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=Shadowalker
WP_ADMIN_USER=shadowadmin
WP_ADMIN_PASSWORD=replace-with-a-long-unique-password
WP_ADMIN_EMAIL=owner@example.com
DB_NAME=shadowalker
DB_USER=shadowalker
DB_PASSWORD=replace-with-a-different-long-password
DB_ROOT_PASSWORD=replace-with-another-long-password
# Development defaults. Pin tested image digests before production.
WORDPRESS_IMAGE=wordpress:php8.3-apache
MARIADB_IMAGE=mariadb:11.4
WPCLI_IMAGE=wordpress:cli-php8.3
DOMAIN=shop.example.com
ACME_EMAIL=owner@example.com
